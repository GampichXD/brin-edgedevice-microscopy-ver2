VPS_WS_URL=ws://202.10.44.52/api/hardware/ws
VPS_BASE_URL=http://202.10.44.52/api/dataset

# Harus sama dengan EDGE_DEVICE_TOKEN di .env VPS.
EDGE_DEVICE_TOKEN=

# Detik tanpa pesan dari VPS sebelum motor ditahan.
WATCHDOG_TIMEOUT=3

# Soft limit aktif secara default. Isi dari hasil ukur rentang mekanis mesin (mm,
# Z dalam step sesuai $102). Sumbu yang dikosongkan tidak dibatasi.
SOFT_LIMITS_ENABLED=1
SOFT_LIMIT_X_MIN=
SOFT_LIMIT_X_MAX=
SOFT_LIMIT_Y_MIN=
SOFT_LIMIT_Y_MAX=
SOFT_LIMIT_Z_MIN=
SOFT_LIMIT_Z_MAX=

# Logging data uji Bab IV (lihat Testing/README.md).
TEST_LOGGING=0
TEST_TELEMETRY_INTERVAL=0.05
